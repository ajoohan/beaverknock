{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/#/ops/live",
      "permanent": false
    },
    {
      "source": "/ops",
      "destination": "/#/ops/live",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!privacy|terms|legal-base\\.css).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
