{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/feed?cron=report-due",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/#/ops/live",
      "permanent": false
    },
    {
      "source": "/ops",
      "destination": "/#/ops/live",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'none'; script-src 'self' 'unsafe-inline' https://cdn.portone.io https://*.portone.io https://cdnjs.cloudflare.com https://accounts.google.com https://maps.googleapis.com https://maps.gstatic.com; connect-src 'self' https://maps.googleapis.com https://places.googleapis.com https://gmbtsucasfwqskfvugzo.supabase.co https://cdn.portone.io https://*.portone.io https://*.iamport.co https://service.iamport.kr https://*.ingest.us.sentry.io https://www.googleapis.com https://accounts.google.com https://api.dropboxapi.com https://content.dropboxapi.com"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!privacy|terms|legal-base\\.css).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/agent-verify.js": {
      "regions": [
        "icn1"
      ]
    }
  },
  "regions": [
    "icn1"
  ]
}
